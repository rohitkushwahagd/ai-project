{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1, "cli": {"analytics": false},
  "projects": {"fieldnotes": {"projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "outputPath": "dist/fieldnotes", "baseHref": "/ui/"},
        "configurations": {"production": {"outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "600kB", "maximumError": "1MB"}]}, "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "production"},
      "serve": {"builder": "@angular/build:dev-server", "configurations": {"development": {"buildTarget": "fieldnotes:build:development"}}, "defaultConfiguration": "development"}
    }
  }}
}
